{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://*.clarity.ms https://c.bing.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io; script-src 'self' 'unsafe-inline' https://esm.sh https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://yvfumgrywsqhsvjfnmzu.supabase.co https://www.clarity.ms https://*.clarity.ms https://c.bing.com; frame-src 'none'; connect-src 'self' https://yvfumgrywsqhsvjfnmzu.supabase.co https://formspree.io https://esm.sh https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/learn/manage",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/learn/manage/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm install --no-audit --no-fund",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/pricing.html",
      "destination": "/services/pricing-and-quotes.html",
      "permanent": true
    },
    {
      "source": "/services/ai-bots-intelligent-agents.html",
      "destination": "/services/ai-chatbots-customer-support.html",
      "permanent": true
    },
    {
      "source": "/services/ai-business-automation.html",
      "destination": "/services/ai-automation-business-everyday-work.html",
      "permanent": true
    },
    {
      "source": "/services/website-design-digital-solutions.html",
      "destination": "/services/website-development-improvement.html",
      "permanent": true
    },
    {
      "source": "/services/ai-automation.html",
      "destination": "/services/ai-automation-business-everyday-work.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/learn/c/:slug/",
      "destination": "/learn/category.html?slug=:slug"
    },
    {
      "source": "/learn/c/:slug",
      "destination": "/learn/category.html?slug=:slug"
    },
    {
      "source": "/learn/r/:slug/",
      "destination": "/learn/resource.html?slug=:slug"
    },
    {
      "source": "/learn/r/:slug",
      "destination": "/learn/resource.html?slug=:slug"
    }
  ]
}
